<androidx.cardview.widget.CardView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="0dp"
    android:layout_marginTop="8dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/items_border"
        >
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:padding="8dp"
         android:orientation="vertical"
        >
        <TextView
            android:id="@+id/tv_docName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/title_style"
            android:text="@string/not_active"
             />
        <TextView
            android:id="@+id/tv_orderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/sub_title_style"
            android:text="@string/not_active"
            android:maxLength="20"
            android:layout_marginTop="8dp"
             />
        <TextView
            android:id="@+id/tv_branchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:text="@string/not_active"
            android:layout_marginTop="8dp"
            android:textColor="@color/colorPrimary"
            android:drawableStart="@drawable/branch_icon"
            android:drawablePadding="4dp"
             />
    </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:padding="8dp"
             android:orientation="vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                style="@style/title_style"
                />
            <TextView
                android:id="@+id/tv_packStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pack"
                android:textColor="@color/textGreen"
                android:padding="4dp"
                style="@style/sub_title_style"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center_horizontal"
                android:background="@drawable/status_bg"
                 />
            <TextView
                android:id="@+id/tv_packDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_active"
                style="@style/sub_title_gray_style"
                android:layout_marginTop="4dp"
                />
        </LinearLayout>
</LinearLayout>
</androidx.cardview.widget.CardView>
