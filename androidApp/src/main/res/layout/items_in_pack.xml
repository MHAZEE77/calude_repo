<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView android:layout_height="wrap_content"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="4dp"
    app:cardElevation="0dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
<RelativeLayout
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:background="@drawable/items_border"
    android:padding="4dp"
    >
    <TextView
        android:id="@+id/tv_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:text="@string/product_name"
        android:visibility="gone"
        />
    <TextView
        android:id="@+id/tv_itemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        style="@style/sub_title_style"
         android:maxLength="15"
         android:text="@string/product_name"
        />
    <TextView
        android:id="@+id/tv_allowable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
         style="@style/sub_title_style"
         android:textAlignment="center"
          android:text="@string/five"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:layout_alignParentEnd="true"
        android:gravity="bottom">
        <ImageView
            android:id="@+id/iv_decreasePack"
            android:layout_width="35dp"
            android:layout_height="35dp"
             android:src="@drawable/decrease_icon"
            android:contentDescription="@string/decrease_quantity"
            android:minWidth="48dp"
            android:minHeight="48dp"
            />
        <EditText
            android:id="@+id/et_packedQ"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"
            android:text="@string/zero"
            style="@style/edit_text_add_pack"
            android:gravity="center"
            android:inputType="number"
            />
        <ImageView
            android:id="@+id/iv_increasePack"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="bottom"
            android:src="@drawable/increase_icon"
            android:contentDescription="@string/increase_quantity"
            android:minWidth="48dp"
            android:minHeight="48dp"
            />
    </LinearLayout>
</RelativeLayout>
</androidx.cardview.widget.CardView>
