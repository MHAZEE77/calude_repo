<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
     app:cardElevation="0dp"
    android:layout_marginTop="8dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <RelativeLayout
         android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@drawable/items_border"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
             android:orientation="vertical">

            <TextView
                android:id="@+id/tv_PD_Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/title_style"
                android:text="@string/not_active"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/height"
                    style="@style/sub_title_style"
                    android:textColor="@color/colorPrimary"
                    />
                <TextView
                    android:id="@+id/tv_PD_Height"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    style="@style/sub_title_style"
                    android:text="@string/not_active"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/length"
                    style="@style/sub_title_style"
                    android:textColor="@color/colorPrimary"
                    />
                <TextView
                    android:id="@+id/tv_PD_Length"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    style="@style/sub_title_style"
                    android:text="@string/not_active"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/uom"
                style="@style/title_style"
                />
            <TextView
                android:id="@+id/tv_uom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bag"
                android:gravity="center_horizontal"
                android:background="@drawable/uom_bg"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="24dp"
            android:layout_marginStart="50dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quantity"
                    style="@style/title_style"
                    android:textColor="@color/colorAccent"
                    />
                <TextView
                    android:id="@+id/tv_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/title_style"
                    android:layout_marginStart="8dp"
                    android:text="@string/not_active"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/width"
                    style="@style/sub_title_style"
                    android:textColor="@color/colorPrimary"
                    />
                <TextView
                    android:id="@+id/tv_PD_Width"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    style="@style/sub_title_style"
                    android:text="@string/not_active"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weight"
                    style="@style/sub_title_style"
                    android:textColor="@color/colorPrimary"
                    />
                <TextView
                    android:id="@+id/tv_PD_Weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/sub_title_style"
                    android:layout_marginStart="16dp"
                    android:text="@string/not_active"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/is_fragile"
                style="@style/title_style"
                />
            <TextView
                android:id="@+id/tv_isFragile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/uom_bg"
                android:gravity="center_horizontal"
                android:text="@string/no"
                />

        </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
