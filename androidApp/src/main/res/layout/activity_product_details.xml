<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:id="@+id/rel_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:scaleType="fitStart"
            android:src="@drawable/back_icon"
            android:contentDescription="@string/back"
            android:minWidth="48dp"
            android:minHeight="48dp"
            />
        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:textSize="20sp"
            />
    </RelativeLayout>
            <LinearLayout
                android:id="@+id/lin_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/item_card_bg"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_below="@+id/rel_header"
                tools:ignore="RtlSymmetry">
                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="120dp"
                        android:layout_height="150dp"
                        android:layout_marginStart="8dp"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/image_placeholder"
                        android:src="@drawable/product_placeholder"
                        tools:ignore="ContentDescription"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Title"
                        tools:text="@string/not_active" />

                    <TextView
                        android:id="@+id/subtitleTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                        tools:text="@string/not_active" />
                    <TextView
                        android:id="@+id/skuTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="16sp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                        tools:text="SKU" />
                </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_below="@+id/lin_item"
            android:background="@drawable/item_card_bg"
             android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:drawablePadding="8dp"
                android:text="@string/location"
                android:textSize="20sp"
                app:drawableStartCompat="@drawable/ic_pin_location" />
            <TextView
                android:id="@+id/tv_noLocationFounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:gravity="center_horizontal"
                android:text="@string/no_location_founded"
                />
            <LinearLayout
                android:id="@+id/lin_locations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_marginBottom="34dp"
                android:orientation="vertical">
                <ListView
                    android:id="@+id/listView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    tools:ignore="NestedScrolling" />
            </LinearLayout>
        </LinearLayout>
        <Button
            android:id="@+id/bt_addLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/add_location"
            style="@style/button_style"
            />
    </RelativeLayout>
