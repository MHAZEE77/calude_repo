<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".app.addStock.AddStockActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar03"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fill_gradient"
        android:fitsSystemWindows="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:src="@drawable/back_icon"
                android:contentDescription="@string/back"
                android:minWidth="48dp"
                android:minHeight="48dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center_vertical"
                android:fontFamily="@font/bold_medium"
                android:text="@string/add_stock"
                android:textColor="@color/colorLight"
                android:textSize="24sp" />
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBar03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/scanLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:textSize="22sp"
                android:fontFamily="@font/regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/scan_product_to_add"
                android:textAlignment="center"
                android:textColor="@color/colorBlack"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/prodImage"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gray_stroke_no_fill"
                android:src="@drawable/placeholder_view"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/title_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/item_code" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvItemcode"
                        style="@style/sub_title_style"
                        android:layout_width="0dp"
                        android:layout_marginEnd="5dp"
                        android:text="@string/not_active"
                        android:gravity="center_horizontal|center_vertical"
                        android:layout_height="40dp"
                        android:layout_weight="3"
                        android:background="@drawable/gray_stroke_no_fill" />

                    <ImageButton
                        android:id="@+id/bt_startScan"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/round_edges"
                        android:padding="5dp"
                        android:src="@drawable/small_qr"
                        app:tint="@color/colorWhite"
                        android:contentDescription="@string/scan"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        />

                </LinearLayout>

                <TextView
                    style="@style/title_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/product_name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvItemName"
                        style="@style/sub_title_style"
                        android:layout_width="0dp"
                        android:layout_marginEnd="5dp"
                        android:text="@string/not_active"
                        android:gravity="center_horizontal|center_vertical"
                        android:layout_height="40dp"
                        android:layout_weight="3"
                        android:background="@drawable/gray_stroke_no_fill" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    style="@style/title_style"
                    android:textSize="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="@string/ware_house" />

                <Spinner
                    android:layout_marginTop="5dp"
                    android:id="@+id/spnWarehouse"
                    style="@style/sub_title_style"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/spinner_style" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    style="@style/title_style"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textSize="18sp"
                    android:text="@string/bin" />

                <Spinner
                    android:layout_marginTop="5dp"
                    android:id="@+id/spnBin"
                    style="@style/sub_title_style"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/spinner_style"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_marginStart="10dp"
                    style="@style/title_style"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textSize="18sp"
                    android:text="@string/qauntity" />

                <EditText
                    android:layout_marginTop="5dp"
                    android:id="@+id/etQty"
                    style="@style/sub_title_style"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="@string/zero"
                    android:gravity="center_horizontal"
                    android:background="@drawable/gray_stroke_no_fill"
                    android:selectAllOnFocus="true"
                    android:inputType="number" />

            </LinearLayout>

            <Button
                android:layout_marginTop="30dp"
                android:id="@+id/bt_update_stock"
                style="@style/button_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_edges"
                android:text="@string/update_stock"
                android:textAllCaps="false" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
